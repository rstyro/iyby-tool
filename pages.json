{
	"easycom": {
		// uview 组件
		"^u-(.*)": "@/uni_modules/uview-ui/components/u-$1/u-$1.vue",
		// 自定义组件
		"^cl-(.*)": "@/components/cl-$1/cl-$1.vue"
	},

	"pages": [ //pages数组中第一项表示应用启动页，参考：https://uniapp.dcloud.io/collocation/pages
		{
			"path": "pages/tabbar/tabbar-home",
			"style": {
				"navigationBarTitleText": "首页"
			}
		},
		{
			"path": "pages/tabbar/tabbar-me",
			"style": {
				"navigationBarTitleText": "我的"
			}
		}
	
	],
	"subPackages": [ {
		"root": "package-index",
		"pages": [{
			"path" : "baseConversion/baseConversion",
			"name":"baseConversion",
			"style" : 
			{
				"navigationBarTitleText" : "进制转换"
			}
		},
		{
			"path" : "ancientMoney/ancientMoney",
			"name":"ancientMoney",
			"style" : 
			{
				"navigationBarTitleText" : "金额大写"
			}
		},
	
		{
			"path" : "timeConversion/timeConversion",
			"name":"timeConversion",
			"style" : 
			{
				"navigationBarTitleText" : "时间转换"
			}
		},
		{
			"path" : "encrypt/base64/base64",
			"name":"base64",
			"style" : 
			{
				"navigationBarTitleText" : "BASE64算法"
			}
		},
		{
			"path" : "encrypt/hash/hash",
			"name":"hash",
			"style" : 
			{
				"navigationBarTitleText" : "消息摘要算法"
			}
		},
		{
			"path" : "encrypt/symmetry/symmetry",
			"name":"symmetry",
			"style" : 
			{
				"navigationBarTitleText" : "对称加密"
			}
		},
		{
			"path" : "encrypt/rsa/rsa",
			"name":"rsa",
			"style" : 
			{
				"navigationBarTitleText" : "非对称加密"
			}
		},
		{
			"path" : "zodiac/zodiac",
			"name":"zodiac",
			"style" : 
			{
				"navigationBarTitleText" : "生肖查询"
			}
		},
		{
			"path" : "barrage/barrage",
			"name":"barrage",
			"style" : 
			{
				"navigationBarTitleText" : "弹幕设置"
			}
		},
		{
			"path" : "horseRaceLamp/horseRaceLamp",
			"name":"horseRaceLamp",
			"style" : 
			{
				"navigationBarTitleText" : "",
				"pageOrientation": "landscape",
				"navigationStyle": "custom"  // 隐藏原生导航栏
			}
		},
		{
			"path" : "pwdGen/pwdGen",
			"name":"pwdGen",
			"style" : 
			{
				"navigationBarTitleText" : "密码生成器"
			}
		},
		{
			"path" : "qrcode/qrcode",
			"name":"qrcode",
			"style" : 
			{
				"navigationBarTitleText" : "二维码"
			}
		},
		{
			"path" : "avatarMix/avatarMix",
			"name":"avatarMix",
			"style" : 
			{
				"navigationBarTitleText" : "头像合成"
			}
		}
		]
	}],
	"preloadRule": {
		"pages/tabbar/tabbar-home": {
			"network": "all",
			"packages": ["package-index"]
		}
	},
	"tabBar": {
		"color": "#909399",
		"selectedColor": "#303133",
		"backgroundColor": "#FFFFFF",
		"borderStyle": "black",
		"list": [{
				"pagePath": "pages/tabbar/tabbar-home",
				"iconPath": "/static/images/tabbar/home.png",
				"selectedIconPath": "/static/images/tabbar/home-active.png",
				"text": "首页"
			},
			{
				"pagePath": "pages/tabbar/tabbar-me",
				"iconPath": "static/images/tabbar/me.png",
				"selectedIconPath": "static/images/tabbar/me-active.png",
				"text": "我的"
			}
		]
	},
	"globalStyle": {
		"navigationBarTextStyle": "black",
		"navigationBarTitleText": "uni-app",
		"navigationBarBackgroundColor": "#F8F8F8",
		"backgroundColor": "#F8F8F8"
	}

}